{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "src/env.d.ts",
    "src/main.ts",
    "src/App.vue",
    "src/router/**/*.ts",
    "src/math/**/*.ts",
    "src/generated/**/*.ts",
    "src/components/AppFooter.vue",
    "src/components/BrandLogo.vue",
    "src/components/MathHeader.vue",
    "src/components/MathMarkdown.vue",
    "src/views/HomePage.vue",
    "src/views/SearchPage.vue",
    "src/views/KnowledgePage.vue"
  ]
}
